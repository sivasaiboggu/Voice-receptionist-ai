# Voice Receptionist dashboard — copy to .env for local dev, or set these
# as environment variables in the Vercel project settings for production.
# Only VITE_* variables are exposed to the browser build.

# Backend API base URL. REQUIRED in production: the deployed backend, e.g.
# https://voice-receptionist-api.onrender.com (no trailing slash).
# Leave blank locally — dev defaults to http://localhost:8001.
# (Set to /api to use the Vite dev proxy instead; see vite.config.ts.)
VITE_API_URL=
