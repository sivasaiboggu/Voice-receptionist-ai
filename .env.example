# Voice Receptionist Agent — free keys only, never commit real keys
# LLM (optional — mock fallback runs with no key)
GEMINI_API_KEY=
# Twilio Voice (optional — demo mode runs with no account)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# WhatsApp / SMS confirmations (optional — free test paths)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Database (SQLite default, free; Postgres URL also works)
DATABASE_URL=sqlite:///./receptionist.db
# Business identity — change per deployment
BUSINESS_NAME=Sunrise Dental Clinic
BUSINESS_PHONE=+91 90000 00000
OWNER_PHONE=+91 9573719115
OWNER_EMAIL=
# Demo mode: true = simulated calls, no phone/account keys needed
DEMO_MODE=true
