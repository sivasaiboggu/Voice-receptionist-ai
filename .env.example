# Voice Receptionist Agent — free keys only, never commit real keys
# Copy to .env for local runs. Every variable below is either read by the
# code (marked READ) or explicitly marked NOT YET READ — nothing here is
# silently ignored.
#
# Backend API (FastAPI, port 8001)
# READ by backend/app/api.py — browser origins allowed to call the API.
# Local dev defaults cover http://localhost:5173/5174. In production set
# this to the deployed frontend origin, e.g.:
# CORS_ORIGINS=https://voice-receptionist.vercel.app
CORS_ORIGINS=
# READ by backend/app/db.py — SQLite only. Postgres URLs are NOT
# supported by the current storage layer and fall back to the default file.
DATABASE_URL=sqlite:///./receptionist.db
# READ by GET /health — true = simulated calls, no phone/account keys needed.
DEMO_MODE=true
# Business identity — BUSINESS_NAME is READ by backend/app/agent.py (greeting).
BUSINESS_NAME=Sunrise Dental Clinic
# READ by backend/app/booking.py — IANA timezone the clinic's slot times
# are in (default Asia/Kolkata). "Past" is judged against this clock, not
# the server's; GET /health and GET /slots report it. An unknown name
# falls back to UTC with a warning.
# CLINIC_TZ=Asia/Kolkata
# NOT YET READ by any code (reserved for caller ID / escalation messages).
BUSINESS_PHONE=+91 90000 00000
OWNER_PHONE=+91 9573719115
OWNER_EMAIL=
# LLM (optional — mock fallback runs with no key)
# READ by backend/app/voice/twilio_voice.py:gemini_polish(), which is not
# yet wired into agent replies — today's replies come from docs/kb/ only.
GEMINI_API_KEY=
# Twilio Voice (optional — demo mode runs with no account)
# READ by backend/app/voice/twilio_voice.py — real calls + SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# WhatsApp confirmations (optional — free test paths)
# NOT YET READ by any code — confirmations currently go through Twilio SMS
# (when configured) or return a demo draft; see POST /notify/sms.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
